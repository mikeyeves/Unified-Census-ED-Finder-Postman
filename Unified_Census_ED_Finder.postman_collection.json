    {
      "name": "6. ED description / transcription (opens in browser)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{morse_baseUrl}}/ed/ed2_pre.php?year={{census_year}}&state={{state}}&ed={{ed}}",
          "host": [
            "{{morse_baseUrl}}"
          ],
          "path": [
            "ed",
            "ed2_pre.php"
          ],
          "query": [
            {
              "key": "year",
              "value": "{{census_year}}",
              "description": "1950, 1940, 1930, 1920, 1910, 1900, 1880 or 1870",
              "disabled": false
            },
            {
              "key": "state",
              "value": "{{state}}",
              "description": "2-letter state code, e.g. NY",
              "disabled": false
            },
            {
              "key": "ed",
              "value": "{{ed}}",
              "description": "",
              "disabled": false
            }
          ]
        },
        "description": "Transcribed boundary description for the ED (pre-1930). For 1930+ change the path to `ed/ed2.php`. Rendered by JavaScript \u2014 open in a browser."
      },
      "response": []
    },
    {
      "name": "7. NARA Catalog: find this ED's scans (1940/1950 only)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{nara_baseUrl}}/records/search?q=\"ED {{ed}}\"&ancestorNaId=43290879&levelOfDescription=item&limit=10",
          "host": [
            "{{nara_baseUrl}}"
          ],
          "path": [
            "records",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "\"ED {{ed}}\"",
              "description": "Exact ED, e.g. \"ED 31-1910\"",
              "disabled": false
            },
            {
              "key": "ancestorNaId",
              "value": "43290879",
              "description": "43290879 = 1950 schedules, 16660414 = 1940",
              "disabled": false
            },
            {
              "key": "levelOfDescription",
              "value": "item",
              "description": "",
              "disabled": false
            },
            {
              "key": "limit",
              "value": "10",
              "description": "",
              "disabled": false
            }
          ]
        },
        "description": "Hands the ED off to the National Archives Catalog API to get the page images. Only 1940 and 1950 are indexed by ED there. Requires `nara_api_key` (collection variable).",
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "key",
              "value": "x-api-key",
              "type": "string"
            },
            {
              "key": "value",
              "value": "{{nara_api_key}}",
              "type": "string"
            },
            {
              "key": "in",
              "value": "header",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ],
